@model OrdemServico

<dialog id="detalheOsModal" class="modal backdrop-blur-md">
    <div class="modal-box w-[640px] h-[640px] max-w-[92vw] border border-[#dedede] flex flex-col">

        <!-- FECHAR (X) -->
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2 text-[#777]">✕</button>
        </form>

        <!-- CABEÇALHO -->
        <h3 class="text-[20px] font-bold text-[#222]">Detalhe da OS</h3>
        <p class="text-[12px] text-[#777]">Ordem de serviço nº @Model.NumeroOs</p>

        <!-- STATUS -->
        <div class="mt-4">
            @if (Model.OsFinalizada)
            {
                <span class="badge badge-soft badge-accent gap-2 rounded-full">
                    <span class="status status-accent"></span>
                    Finalizada
                </span>
            }
            else
            {
                <span class="badge badge-soft badge-warning gap-2 rounded-full">
                    <span class="status status-warning"></span>
                    Pendente
                </span>
            }
        </div>

        <!-- CAMPOS -->
        <div class="mt-5 grid grid-cols-2 gap-x-6 gap-y-4">
            <div>
                <p class="text-[12px] text-[#777] mb-1">Cliente</p>
                <p class="text-[13px] font-semibold text-[#222]">@(Model.Clientes?.RazaoSocial ?? "—")</p>
            </div>
            <div>
                <p class="text-[12px] text-[#777] mb-1">Técnico</p>
                <p class="text-[13px] font-semibold text-[#222]">@(Model.Colaboradores?.Nome ?? "—")</p>
            </div>
            <div>
                <p class="text-[12px] text-[#777] mb-1">Tipo de serviço</p>
                <p class="text-[13px] font-semibold text-[#222]">@Model.TipoServico</p>
            </div>
            <div>
                <p class="text-[12px] text-[#777] mb-1">Valor</p>
                <p class="text-[13px] font-semibold text-[#222]">R$ @Model.ValorTotal</p>
            </div>
            <div>
                <p class="text-[12px] text-[#777] mb-1">Data de abertura</p>
                <p class="text-[13px] font-semibold text-[#222]">@Model.DataAbertura.ToString("dd/MM/yyyy")</p>
            </div>
            <div>
                <p class="text-[12px] text-[#777] mb-1">Data de fechamento</p>
                <p class="text-[13px] font-semibold text-[#222]">@(Model.DataFechamento?.ToString("dd/MM/yyyy") ?? "—")</p>
            </div>
        </div>

        <!-- ANEXOS -->
        <div class="mt-6 flex-1 min-h-0 flex flex-col">

            <p class="text-[12px] text-[#777] mb-2">
                Anexos <span id="contadorAnexos"></span>
            </p>

            @if (!Model.OsFinalizada)
            {
                <input type="file" id="inputAnexosOs" multiple class="hidden" />

                <label for="inputAnexosOs"
                       class="h-[38px] px-4 self-start inline-flex items-center bg-white border border-[#d5d5d5] rounded-md text-[12px] text-[#555] hover:bg-[#f7f7f7] cursor-pointer">
                    + Adicionar anexo
                </label>
            }

            <!-- BOX DA LISTA -->
            <div id="boxAnexos" class="mt-3 flex-1 min-h-0 overflow-y-auto pr-1">

                <p id="mensagemVazia" class="text-[12px] text-[#999]">
                    Nenhum anexo.
                </p>

                <div id="listaAnexos" class="space-y-1"></div>

            </div>

        </div>

        <!-- AÇÕES -->
        <div class="modal-action">
  
            @if (!Model.OsFinalizada)
            {
                <p id="avisoFinalizar" class="text-[12px] text-[#c0392b] self-center mr-2">
                    Anexe ao menos um arquivo para finalizar a OS
                </p>

                <button type="button" id="btnFinalizarOs" disabled
                        class="h-[38px] px-4 bg-[#168bd0] border border-[#168bd0] rounded-md text-[12px] text-white opacity-50 cursor-not-allowed">
                    Finalizar OS
                </button>
            }

        </div>
    </div>

    <!-- CLIQUE FORA FECHA -->
    <form method="dialog" class="modal-backdrop">
        <button>fechar</button>
    </form>
</dialog>

<script>
    (function() {

        document.getElementById('detalheOsModal').showModal();

        // Deixa a rolagem dos anexos mais lenta (30% da velocidade normal)
        var boxAnexos = document.getElementById('boxAnexos');
        boxAnexos.addEventListener('wheel', function(e) {
            e.preventDefault();
            boxAnexos.scrollTop += e.deltaY * 0.3;
        }, { passive: false });

        @if (!Model.OsFinalizada)
            {
                <text>
                        var arquivosSelecionados = [];

                        var inputArquivos = document.getElementById('inputAnexosOs');
                        var listaAnexos = document.getElementById('listaAnexos');
                        var mensagemVazia = document.getElementById('mensagemVazia');
                        var contadorAnexos = document.getElementById('contadorAnexos');
                        var btnFinalizarOs = document.getElementById('btnFinalizarOs');
                        var avisoFinalizar = document.getElementById('avisoFinalizar');

                        inputArquivos.addEventListener('change', function () {
                            adicionarArquivos(this.files);
                        this.value = '';
                            });

                        btnFinalizarOs.addEventListener('click', function () {
                            // TODO: enviar anexos + finalizar OS
                        });

                        function adicionarArquivos(files) {
                                var novosArquivos = Array.from(files);
                        arquivosSelecionados = arquivosSelecionados.concat(novosArquivos);
                        atualizarLista();
                            }

                        function removerArquivo(indice) {
                            arquivosSelecionados.splice(indice, 1);
                        atualizarLista();
                            }

                        function atualizarLista() {

                                var temAnexos = arquivosSelecionados.length > 0;

                        contadorAnexos.textContent = temAnexos ? '(' + arquivosSelecionados.length + ')' : '';

                        if (temAnexos) {
                            btnFinalizarOs.disabled = false;
                        btnFinalizarOs.classList.remove('opacity-50', 'cursor-not-allowed');
                        avisoFinalizar.style.display = 'none';
                                } else {
                            btnFinalizarOs.disabled = true;
                        btnFinalizarOs.classList.add('opacity-50', 'cursor-not-allowed');
                        avisoFinalizar.style.display = 'block';
                                }

                        mensagemVazia.style.display = temAnexos ? 'none' : 'block';

                        listaAnexos.innerHTML = '';

                        arquivosSelecionados.forEach(function (arquivo, indice) {

                                    var item = document.createElement('div');
                        item.className = 'flex items-center justify-between bg-[#f7f7f7] border border-[#dedede] rounded-md px-3 py-2';

                        var nome = document.createElement('span');
                        nome.className = 'text-[12px] text-[#555] truncate';
                        nome.textContent = arquivo.name;

                        var btnRemover = document.createElement('button');
                        btnRemover.type = 'button';
                        btnRemover.className = 'w-6 h-6 flex items-center justify-center rounded-full bg-[#fdecea] text-[#c0392b] text-[12px] shrink-0 ml-3 hover:bg-[#f5c6c2]';
                        btnRemover.textContent = '✕';
                        btnRemover.onclick = function () {
                            removerArquivo(indice);
                                    };

                        item.appendChild(nome);
                        item.appendChild(btnRemover);
                        listaAnexos.appendChild(item);
                                });
                            }
                </text>
        }

        })();
</script>