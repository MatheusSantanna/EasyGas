@model EasyGas.Models.Clientes

@{
    ViewData["Title"] = Model.Id > 0 ? "Editar cliente" : "Cadastrar cliente";
    var isEdicao = Model.Id > 0;
}

<div class="min-h-screen bg-[#f3f3f3]">

    <main class="p-6">

        <div class="max-w-[1100px] mx-auto">

            <div class="mb-5">
                <h1 class="text-[20px] font-bold text-[#222]">
                    @(isEdicao ? "Editar cliente" : "Cadastrar cliente")
                </h1>

                <p class="text-[12px] text-[#777]">
                    @(isEdicao
                        ? "Atualize os dados do cliente selecionado."
                        : "Informe os dados para cadastrar um novo cliente.")
                </p>
            </div>

            <div class="bg-white border border-[#dedede] rounded-md overflow-hidden">

                <form asp-controller="Clientes"
                      asp-action="PostClientes"
                      method="post"
                      class="p-6">

                    <input type="hidden" asp-for="Id" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="mb-4 text-[12px] text-red-600">
                            <div asp-validation-summary="All"></div>
                        </div>
                    }

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

                        <div>
                            <label asp-for="RazaoSocial" class="block mb-1 text-[12px] text-[#555]">
                                Razão Social
                            </label>
                            <input asp-for="RazaoSocial"
                                   placeholder="Razão social do cliente"
                                   class="w-full h-[38px] px-3 bg-white border border-[#d5d5d5] rounded-md text-[12px] text-[#555] outline-none focus:border-[#168bd0]" />
                        </div>

                        <div>
                            <label asp-for="Cnpj" class="block mb-1 text-[12px] text-[#555]">
                                CNPJ
                            </label>
                            <input asp-for="Cnpj"
                                   placeholder="00.000.000/0000-00"
                                   class="w-full h-[38px] px-3 bg-white border border-[#d5d5d5] rounded-md text-[12px] text-[#555] outline-none focus:border-[#168bd0]" />
                        </div>

                    </div>

                    <div class="flex items-center gap-2 mb-6">
                        <input asp-for="Ativo"
                               class="h-4 w-4 accent-[#168bd0]" />
                        <label asp-for="Ativo" class="text-[12px] text-[#555]">
                            Cliente ativo
                        </label>
                    </div>

                    <div class="flex gap-2 justify-end">
                        <a asp-controller="Clientes"
                           asp-action="ListaClientes"
                           class="h-[38px] px-4 inline-flex items-center bg-white border border-[#d5d5d5] rounded-md text-[12px] text-[#555] hover:bg-[#f7f7f7]">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="h-[38px] px-4 bg-[#168bd0] border border-[#168bd0] rounded-md text-[12px] text-white hover:bg-[#137bb8]">
                            @(isEdicao ? "Salvar alterações" : "Cadastrar")
                        </button>
                    </div>

                </form>

            </div>

        </div>

    </main>

</div>
