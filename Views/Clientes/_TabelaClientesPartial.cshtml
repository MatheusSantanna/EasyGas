@model IEnumerable<EasyGas.Models.Clientes>

<table class="table table-zebra w-full">
    <thead>
    <tr>
        <th>Razão Social</th>
        <th>CNPJ</th>
        <th>Ativo</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var cliente in Model)
    {
        <tr class="hover cursor-pointer"
            onclick="window.location='@Url.Action("PostClientes", "Clientes", new { id = cliente.Id })'">
            <td>@cliente.RazaoSocial</td>
            <td>@cliente.Cnpj</td>
            @if(@cliente.Ativo == true) 
            {
                <td>Sim</td>
            }
            else
            {
                <td>Não</td>
            }
            
        </tr>
    }
    @if (!Model.Any())
    {
        <tr>
            <td colspan="2" class="text-center py-4">Nenhum cliente encontrado.</td>
        </tr>
    }
    </tbody>
</table>