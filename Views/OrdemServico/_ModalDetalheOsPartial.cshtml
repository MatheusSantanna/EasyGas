@model OrdemServico

<dialog id="detalheOsModal"
        class="modal"
        aria-labelledby="tituloDetalheOs">

    <div class="modal-box w-[640px] h-[640px] max-w-[92vw] border border-[#dedede] flex flex-col">

        <!-- FECHAR -->
        <form method="dialog">
            <button type="submit"
                    aria-label="Fechar detalhes"
                    class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2 text-[#777]">
                ✕
            </button>
        </form>

        <!-- CABEÇALHO -->
        <h3 id="tituloDetalheOs"
            class="text-[20px] font-bold text-[#222]">
            Detalhe da OS
        </h3>

        <p class="text-[12px] text-[#777]">
            Ordem de serviço nº @Model.NumeroOs
        </p>

        <!-- STATUS -->
        <div class="mt-4">
            @if (Model.OsFinalizada)
            {
                <span class="badge badge-soft badge-accent gap-2 rounded-full">
                    <span class="status status-accent"></span>
                    Finalizada
                </span>
            }
            else
            {
                <span class="badge badge-soft badge-warning gap-2 rounded-full">
                    <span class="status status-warning"></span>
                    Pendente
                </span>
            }
        </div>

        <!-- CAMPOS -->
        <div class="mt-5 grid grid-cols-2 gap-x-6 gap-y-4">
            <div>
                <p class="text-[12px] text-[#777] mb-1">Cliente</p>
                <p class="text-[13px] font-semibold text-[#222]">
                    @(Model.Clientes?.RazaoSocial ?? "—")
                </p>
            </div>

            <div>
                <p class="text-[12px] text-[#777] mb-1">Técnico</p>
                <p class="text-[13px] font-semibold text-[#222]">
                    @(Model.Colaboradores?.Nome ?? "—")
                </p>
            </div>

            <div>
                <p class="text-[12px] text-[#777] mb-1">Tipo de serviço</p>
                <p class="text-[13px] font-semibold text-[#222]">
                    @Model.TipoServico
                </p>
            </div>

            <div>
                <p class="text-[12px] text-[#777] mb-1">Valor</p>
                <p class="text-[13px] font-semibold text-[#222]">
                    R$ @Model.ValorTotal.ToString("N2")
                </p>
            </div>

            <div>
                <p class="text-[12px] text-[#777] mb-1">Data de abertura</p>
                <p class="text-[13px] font-semibold text-[#222]">
                    @Model.DataAbertura.ToString("dd/MM/yyyy")
                </p>
            </div>

            <div>
                <p class="text-[12px] text-[#777] mb-1">Data de fechamento</p>
                <p class="text-[13px] font-semibold text-[#222]">
                    @(Model.DataFechamento?.ToString("dd/MM/yyyy") ?? "—")
                </p>
            </div>
        </div>

        <!-- ANEXOS -->
        <div class="mt-6 flex-1 min-h-0 flex flex-col">

            <p class="text-[12px] text-[#777] mb-2">
                Anexos salvos
                <span>(@(Model.Anexos?.Count ?? 0))</span>
            </p>

            <div id="boxAnexos"
                 class="flex-1 min-h-0 overflow-y-auto pr-1">

                <!-- ANEXOS QUE JÁ ESTÃO NO BANCO -->
                @if (Model.Anexos != null && Model.Anexos.Any())
                {
                    <div class="space-y-2">
                        @foreach (var anexo in Model.Anexos)
                        {
                            <div class="flex items-center justify-between gap-3 bg-[#f7f7f7] border border-[#dedede] rounded-md px-3 py-2">

                                <span class="text-[12px] text-[#555] truncate"
                                      title="@anexo.NomeOriginal">
                                    @anexo.NomeOriginal
                                </span>

                                <a asp-controller="OrdemServico"
                                   asp-action="BaixarAnexo"
                                   asp-route-id="@anexo.Id"
                                   title="Baixar @anexo.NomeOriginal"
                                   aria-label="Baixar @anexo.NomeOriginal"
                                   class="shrink-0 text-[#168bd0] hover:text-[#137bb8]">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         class="h-4 w-4"
                                         fill="none"
                                         viewBox="0 0 24 24"
                                         stroke="currentColor"
                                         stroke-width="2">
                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                    </svg>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-[12px] text-[#999]">
                        Nenhum anexo salvo.
                    </p>
                }

                <!-- ARQUIVOS SELECIONADOS PARA ENVIO -->
                @if (!Model.OsFinalizada)
                {
                    <div class="mt-5">
                        <p class="text-[12px] text-[#777] mb-2">
                            Novos anexos
                            <span id="contadorAnexos"></span>
                        </p>

                        <input type="file"
                               id="inputAnexosOs"
                               name="anexos"
                               form="formFinalizarOs"
                               multiple
                               class="hidden" />

                        <label for="inputAnexosOs"
                               class="h-[38px] px-4 inline-flex items-center bg-white border border-[#d5d5d5] rounded-md text-[12px] text-[#555] hover:bg-[#f7f7f7] cursor-pointer">
                            + Adicionar anexo
                        </label>

                        <p id="mensagemVazia"
                           class="mt-3 text-[12px] text-[#999]">
                            Nenhum novo arquivo selecionado.
                        </p>

                        <div id="listaAnexos" class="mt-3 space-y-1"></div>
                    </div>
                }

            </div>
        </div>
        <!-- ERROS -->
        <p id="erroFinalizarOs"
           role="alert"
           class="hidden mt-3 text-[12px] text-[#c0392b]">
        </p>

        <!-- AÇÕES -->
        <div class="modal-action">
            @if (!Model.OsFinalizada)
            {
                <p id="avisoFinalizar"
                   class="text-[12px] text-[#c0392b] self-center mr-2">
                    Anexe ao menos um arquivo para finalizar a OS.
                </p>

                <form id="formFinalizarOs"
                      method="post"
                      enctype="multipart/form-data"
                      hx-post="@Url.Action("FinalizarOs", "OrdemServico")"
                      hx-encoding="multipart/form-data"
                      hx-target="#tabela-ordensServico-container"
                      hx-swap="innerHTML"
                      hx-disabled-elt="#btnFinalizarOs">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            id="btnFinalizarOs"
                            disabled
                            class="h-[38px] px-4 bg-[#168bd0] border border-[#168bd0] rounded-md text-[12px] text-white opacity-50 cursor-not-allowed">
                        Finalizar OS
                    </button>
                </form>
            }

            <form method="dialog">
                <button type="submit"
                        class="h-[38px] px-4 bg-white border border-[#d5d5d5] rounded-md text-[12px] text-[#555] hover:bg-[#f7f7f7]">
                    Fechar
                </button>
            </form>
        </div>
    </div>

    <!-- CLIQUE FORA FECHA -->
    <form method="dialog" class="modal-backdrop">
        <button type="submit">Fechar</button>
    </form>
</dialog>

<script>
    (function() {
        const modal = document.getElementById('detalheOsModal');

        if (!modal) {
            return;
        }

        if (!modal.open) {
            modal.showModal();
        }

        const form = modal.querySelector('#formFinalizarOs');

        // OS finalizada: não há formulário de envio.
        if (!form) {
            return;
        }

        const inputArquivos = modal.querySelector('#inputAnexosOs');
        const listaAnexos = modal.querySelector('#listaAnexos');
        const mensagemVazia = modal.querySelector('#mensagemVazia');
        const contadorAnexos = modal.querySelector('#contadorAnexos');
        const btnFinalizarOs = modal.querySelector('#btnFinalizarOs');
        const avisoFinalizar = modal.querySelector('#avisoFinalizar');
        const erroFinalizar = modal.querySelector('#erroFinalizarOs');

        let arquivosSelecionados = [];

        inputArquivos.addEventListener('change', function() {
            const novosArquivos = Array.from(inputArquivos.files);

            arquivosSelecionados.push(...novosArquivos);

            atualizarLista();
        });

        function sincronizarInput() {
            const transferencia = new DataTransfer();

            arquivosSelecionados.forEach(function(arquivo) {
                transferencia.items.add(arquivo);
            });

            inputArquivos.files = transferencia.files;
        }

        function removerArquivo(indice) {
            arquivosSelecionados.splice(indice, 1);

            atualizarLista();
        }

        function atualizarLista() {
            sincronizarInput();

            const temAnexos = arquivosSelecionados.length > 0;

            contadorAnexos.textContent = temAnexos
                ? '(' + arquivosSelecionados.length + ')'
                : '';

            mensagemVazia.classList.toggle('hidden', temAnexos);
            avisoFinalizar.classList.toggle('hidden', temAnexos);

            btnFinalizarOs.disabled = !temAnexos;
            btnFinalizarOs.classList.toggle('opacity-50', !temAnexos);
            btnFinalizarOs.classList.toggle('cursor-not-allowed', !temAnexos);

            erroFinalizar.textContent = '';
            erroFinalizar.classList.add('hidden');

            listaAnexos.replaceChildren();

            arquivosSelecionados.forEach(function(arquivo, indice) {
                const item = document.createElement('div');

                item.className =
                    'flex items-center justify-between bg-[#f7f7f7] ' +
                    'border border-[#dedede] rounded-md px-3 py-2';

                const nome = document.createElement('span');

                nome.className = 'text-[12px] text-[#555] truncate';
                nome.textContent = arquivo.name;
                nome.title = arquivo.name;

                const btnRemover = document.createElement('button');

                btnRemover.type = 'button';
                btnRemover.className =
                    'w-6 h-6 flex items-center justify-center rounded-full ' +
                    'bg-[#fdecea] text-[#c0392b] text-[12px] shrink-0 ' +
                    'ml-3 hover:bg-[#f5c6c2]';

                btnRemover.textContent = '✕';

                btnRemover.setAttribute(
                    'aria-label',
                    'Remover ' + arquivo.name
                );

                btnRemover.addEventListener('click', function() {
                    removerArquivo(indice);
                });

                item.append(nome, btnRemover);
                listaAnexos.appendChild(item);
            });
        }

        function mostrarErro(mensagem) {
            erroFinalizar.textContent = mensagem;
            erroFinalizar.classList.remove('hidden');
        }

        // Os arquivos já estão sincronizados antes de o HTMX coletá-los.
        form.addEventListener('htmx:beforeRequest', function() {
            erroFinalizar.textContent = '';
            erroFinalizar.classList.add('hidden');
        });

        form.addEventListener('htmx:afterRequest', function(event) {
            if (event.detail.successful) {
                modal.close();
            }
        });

        form.addEventListener('htmx:responseError', function(event) {
            const resposta = event.detail.xhr;
            const tipo = resposta.getResponseHeader('Content-Type') || '';

            // Só mostra a resposta diretamente quando ela é texto simples.
            const mensagem = tipo.includes('text/plain')
                ? resposta.responseText
                : 'Não foi possível finalizar a OS. Confira os dados e tente novamente.';

            mostrarErro(mensagem);
        });

        form.addEventListener('htmx:sendError', function() {
            mostrarErro(
                'Não foi possível conectar ao servidor. Tente novamente.'
            );
        });

        atualizarLista();
    })();
</script>