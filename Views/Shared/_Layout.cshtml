@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var clientesAtivo = controller == "Clientes";
}

<!DOCTYPE html>
<html lang="pt-br" data-theme="corporate">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EasyGas</title>

    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.7.2/dist/full.min.css"
          rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            daisyui: {
                themes: ["corporate"]
            }
        }
    </script>

    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
</head>

<body class="min-h-screen bg-base-200 text-base-content">

    <!-- Navbar -->
    <div class="navbar h-14 min-h-0 bg-base-100 border-b border-base-300 px-5">

        <div class="flex-1">
            <span class="text-base font-bold">
                EasyGas
            </span>
        </div>

        <div class="flex items-center gap-4">
            </div>

        </div>
    


    <!-- Corpo -->
    <div class="flex min-h-[calc(100vh-3.5rem)]">

        <!-- Sidebar -->
        <aside class="w-52 shrink-0 bg-base-200 border-r border-base-300 p-3 flex flex-col justify-between">

            <ul class="menu w-full p-0">
                
                <li>
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="text-sm py-3">
                        inicio
                    </a>
                </li>

                <li>
                    <a asp-controller="Clientes"
                       asp-action="ListaClientes"
                       class="text-sm py-3">
                        Clientes
                    </a>
                </li>



            </ul>
            

        </aside>


        <!-- Conteúdo original / Wizard -->
        <main id="main-content"
              class="flex-1 min-w-0 p-6 bg-base-200">

            @RenderBody()

        </main>

    </div>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>